# Chỉ true mới dùng dữ liệu mẫu; mặc định app gọi FastAPI.
EXPO_PUBLIC_IS_MOCKING=false
# Origin dev tin cậy; điện thoại thật cần backend LAN/HTTPS và cập nhật http.ts.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Điền thông tin công khai của dự án Supabase; không dùng service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=