# Chỉ true mới dùng dữ liệu mẫu; mặc định app gọi FastAPI.
EXPO_PUBLIC_IS_MOCKING=false
# Đích FastAPI được chọn lúc build. Bản phát hành yêu cầu HTTPS.
# Khi dev: web dùng localhost, Android emulator dùng 10.0.2.2,
# điện thoại thật dùng IP LAN của máy chạy backend (ví dụ http://192.168.1.10:8000).
# Backend cần lắng nghe 0.0.0.0 và firewall cho phép cổng này trên mạng nội bộ.
# Khởi động lại Expo sau khi đổi biến; không cần sửa http.ts.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Điền thông tin công khai của dự án Supabase; không dùng service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
