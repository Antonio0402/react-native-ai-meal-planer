# Chỉ true mới dùng dữ liệu mẫu; mặc định app gọi FastAPI.
EXPO_PUBLIC_IS_MOCKING=false
# Đích FastAPI được chọn lúc build. Bản phát hành yêu cầu HTTPS.
# Khi dev: web dùng localhost, thiết bị thật (Expo Go) tự động nhận diện IP máy dev
# từ Expo Constants khi API_URL trỏ về 127.0.0.1; Android emulator dùng 10.0.2.2.
# Backend cần lắng nghe 0.0.0.0 và firewall cho phép cổng 8000 trên mạng nội bộ.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Điền thông tin công khai của dự án Supabase; không dùng service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
